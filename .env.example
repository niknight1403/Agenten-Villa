# Optional Umami analytics configuration.
# Leave both values empty to disable analytics without build warnings.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Absolute URL of the deployed backend (no trailing /api/trpc).
# Production build (Dockerfile) pins this to https://agenten-villa.onrender.com by default.
# Leave empty for local development (relative /api/trpc).
VITE_API_URL=

# PostgreSQL-Verbindung (Neon) – Pflicht fuer Login/Villen-Speicher
DATABASE_URL=

# Server-HS256-Secret fuer Session-Cookies (app_session_id). Pflicht fuer Login.
JWT_SECRET=

# Server-Port (Default 3000).
PORT=3000

# Google OAuth (Account-System / "Mit Google anmelden") — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <server-url>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Fest gepinnte öffentliche Basis-URL (ohne Trailing Slash). Entfernt die
# Abhängigkeit von Proxy-Headern bei der Google-Callback-URI.
PUBLIC_BASE_URL=

# Administrator-Allowlist: diese E-Mail erhält beim Google-Login automatisch role=admin
AGENT_ADMIN_EMAIL=
# Optional: Operator-Rolle (unterhalb Admin) per E-Mail-Allowlist.
AGENT_OPERATOR_EMAIL=

# Primäre kostenlose Modellroute. Schlüssel immer nur als Server-Secret setzen.
OPENROUTER_API_KEY=
# Optionaler Basis-URL-Override (z. B. lokaler Mock http://127.0.0.1:<port>/v1
# oder selbst gehostetes Gateway). Endpunkt: <base>/chat/completions bzw. /models.
# Leer = https://openrouter.ai/api/v1.
OPENROUTER_BASE_URL=

# Multi-Provider-Failover: ist ein Kontingent erschöpft, wechselt die Kette
# automatisch zum nächsten Anbieter (OpenRouter -> Groq -> Gemini) und nutzt
# ausschließlich dessen eigenes Kontingent. Alle Schlüssel optional; jeder
# konfigurierte Anbieter erhöht die tägliche Entwicklungskapazität.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optionale Modellketten je Anbieter (Komma-Liste, max. 6) und HF-Modell.
#GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
#GEMINI_MODELS=gemini-3.8-flash
#HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Optionaler, ausdrücklich aktivierbarer Hugging-Face-Fallback (Chat).
HF_TOKEN=

# Provider-Wächter: Intervall in ms (Default 300000, min. 30000, max. 3600000).
PROVIDER_GUARDIAN_INTERVAL_MS=
# Optionale Reihenfolge der Provider im Failover (Komma-Liste, Namen aus
# server/provider-registry.ts, z. B. openrouter,groq,gemini).
PROVIDER_FALLBACK_ORDER=
# Optionaler Status je Provider: PROVIDER_STATUS_<NAME>=active|maintenance|retired
# (Hauptname anpassen, z. B. PROVIDER_STATUS_GROQ).
#PROVIDER_STATUS_GROQ=
#PROVIDER_STATUS_OPENROUTER=
#PROVIDER_STATUS_GEMINI=
#PROVIDER_STATUS_HUGGINGFACE=

# GitHub-Connector für Elite-Missionen. Minimal notwendige Repository-Rechte verwenden.
# Der Agent selbst schreibt weiterhin nur auf agent/*-Branches und öffnet Draft-PRs.
GITHUB_TOKEN=
# Optional: Ziel-Repository im Format owner/name (Default niknight1403/Agenten-Villa).
GITHUB_REPOSITORY=

# Free-Tier-Optimierung: freie Modellkette (Komma-Liste, max. 6).
# Default: openrouter/free (Auto-Router über alle freien Modelle).
#OPENROUTER_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODELS=

# Elite-Ausgabelimit je einzelnen Provider-Aufruf.
# Kein lokales Gesamt-Tokenkonto: Administrator Elite hat in der App keine Gesamtquote.
# Externe Modelle besitzen trotzdem technische Kontext-/Ausgabelimits.
# Erlaubter Bereich: mindestens Standardlimit, maximal 8192.
ELITE_MAX_OUTPUT_TOKENS=4096

# Antwort-Cache: in Produktion standardmäßig aktiv (10 Min TTL, 256 Einträge).
# 0 = aus, 1 = auch außerhalb der Produktion an. TTL via FREE_TIER_CACHE_TTL_SECONDS.
FREE_TIER_CACHE=
FREE_TIER_CACHE_TTL_SECONDS=

# --- Sprint 102: Ollama auf Oracle (Always Free) — unbegrenzte eigene Route ---
# Reverse-Proxy-Endpunkt der eigenen VM (siehe docs/OLLAMA-ORACLE-FREE.md)
# Leer = Route nicht eingerichtet.
OLLAMA_BASE_URL=
# Bearer-Token des nginx-Proxys (Bootstrap: openssl rand -hex 32)
OLLAMA_API_KEY=
# CPU-Inferenz ist langsam: eigenes Zeitlimit 120-600000 ms (Default 120000)
OLLAMA_TIMEOUT_MS=600000
# Optional: Modellkette (Komma-Liste), KV-Cache-Kontext (512-8192, Default 2048)
# und Resident-Haltezeit (Default "30m").
#OLLAMA_MODELS=gemma4:12b,devstral:24b
OLLAMA_NUM_CTX=
OLLAMA_KEEP_ALIVE=

# --- Weitere optionale Server-/Client-Flags (alle leer = Default) ---
# App-ID fuer Session-Verifizierung (Default agenten-villa).
VITE_APP_ID=
# Auth-/Forge-Konfiguration (nur setzen, wenn die jeweilige Integration genutzt wird).
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Zusätzliche Capacitor-Origins (Komma-Liste).
CAPACITOR_ORIGINS=
# Bootstrap-Session fuer den Client (siehe client/src/main.tsx).
#VITE_BOOTSTRAP_SESSION=

# --- Feintuning (ms / Anzahl; leer = Code-Default) ---
HAARA_MAX_CONCURRENCY=
WATCHDOG_TICK_MS=
ROUTE_WAIT_BUDGET_MS=

# --- Optional: Abrechnung (nur mit Keys aktiv; Freigabe separat) ---
STRIPE_SECRET_KEY=
STRIPE_CHECKOUT_APPROVED=

# --- Live-Testschalter (niemals mit echten Werten einchecken) ---
#RUN_LIVE_OPENROUTER_CHECK=1
#RUN_LIVE_GITHUB_SECRET=1

# --- Deploy-Sync (scripts/render-secrets-sync.mjs; nur fuer Owner-Deploy) ---
RENDER_API_KEY=
RENDER_SERVICE_ID=
RENDER_SERVICE_NAME=
