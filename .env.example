# Optional Umami analytics configuration.
# Leave both values empty to disable analytics without build warnings.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Absolute URL of the deployed backend (no trailing /api/trpc).
# Production build (Dockerfile) pins this to https://agenten-villa.onrender.com by default.
# Leave empty for local development (relative /api/trpc).
VITE_API_URL=

# Google OAuth (Account-System / "Mit Google anmelden") — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <server-url>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Administrator-Allowlist: diese E-Mail erhält beim Google-Login automatisch role=admin
AGENT_ADMIN_EMAIL=

# Free-Tier-Optimierung: freie Modellkette (Komma-Liste, max. 6).
# Default: openrouter/free (Auto-Router über alle freien Modelle).
#OPENROUTER_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODELS=

# Antwort-Cache: in Produktion standardmäßig aktiv (10 Min TTL, 256 Einträge).
# 0 = aus, 1 = auch außerhalb der Produktion an. TTL via FREE_TIER_CACHE_TTL_SECONDS.
FREE_TIER_CACHE=
FREE_TIER_CACHE_TTL_SECONDS=
