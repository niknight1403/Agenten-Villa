# Kopiere diese Datei zu deploy/.env und fuelle die Werte aus.
# Quelle fuer alles: Render-Umgebung der laufenden Instanz (Render-Dashboard -> Environment).

NODE_ENV=production

# Neon Postgres (unveraendert von Render uebernehmen)
DATABASE_URL=postgres://...

# Auth: ein langer zufaelliger String, z.B. aus: openssl rand -hex 32
JWT_SECRET=

# Admin-Allowlist (deine E-Mail)
AGENT_ADMIN_EMAIL=

# KI-Modelle (OpenRouter Free)
OPENROUTER_API_KEY=

# GitHub (Elite-Missionen auf agent/*-Branches)
GITHUB_TOKEN=

# Google OAuth (Account-System) - Redirect-URI fuer die neue Domain
# in der Google Cloud Console ergaenzen: https://cybersarah-ki.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pinnt die oeffentliche URL (Google-Redirect, Cookies)
PUBLIC_BASE_URL=https://cybersarah-ki.com
