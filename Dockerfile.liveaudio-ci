FROM ghcr.io/cirruslabs/android-sdk:36-ndk

USER root
ARG GRADLE_VERSION=9.3.1
ENV DEBIAN_FRONTEND=noninteractive
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="/opt/gradle/gradle-${GRADLE_VERSION}/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jdk-headless wget unzip python3 \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -O /tmp/gradle.zip \
    && mkdir -p /opt/gradle \
    && unzip -q /tmp/gradle.zip -d /opt/gradle \
    && rm /tmp/gradle.zip

RUN yes | sdkmanager --licenses >/dev/null || true \
    && sdkmanager --install "platform-tools" "platforms;android-36" "build-tools;36.0.0" "cmake;3.22.1" "ndk;28.1.13356709"

WORKDIR /workspace
COPY liveaudio-ci/ /workspace/

RUN java -version \
    && gradle --version \
    && gradle --no-daemon --max-workers=2 -Dorg.gradle.jvmargs="-Xmx1536m -Dfile.encoding=UTF-8" \
       :app:testDebugUnitTest :app:lintDebug :app:assembleDebug :app:bundleRelease --stacktrace \
    && APK="$(find app/build/outputs/apk/debug -name '*.apk' | head -n 1)" \
    && AAB="$(find app/build/outputs/bundle/release -name '*.aab' | head -n 1)" \
    && test -f "$APK" \
    && test -f "$AAB" \
    && unzip -l "$APK" | grep -E 'lib/.+/libliveaudio\.so$' \
    && unzip -l "$AAB" | grep -E 'base/lib/.+/libliveaudio\.so$' \
    && mkdir -p /health \
    && printf 'GREEN\n' > /health/index.html \
    && cp "$APK" /health/LiveAudioPerformanceStudio-debug.apk \
    && cp "$AAB" /health/LiveAudioPerformanceStudio-release.aab

CMD ["bash","-lc","python3 -m http.server ${PORT:-10000} --directory /health"]
